# WhatsApp Cloud API (Meta app → WhatsApp → API Setup). Use a permanent System User token in production.
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Meta app → App settings → Basic → App secret. Used to check that every webhook really comes from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any long random string. Paste the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=make-up-a-long-random-string
# Optional, default v23.0
WHATSAPP_API_VERSION=v23.0

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-sonnet-5. claude-haiku-4-5 is cheaper and faster.
# Not claude-opus-5-5 or claude-fable-5-1: they refuse the forced tool call the reply uses.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: how the assistant introduces the business
BUSINESS_NAME=Acme Growth
BUSINESS_ABOUT=a digital marketing and automation agency

# GoHighLevel (Settings → Private Integrations, scopes: View Contacts and Edit Contacts)
GHL_API_KEY=pit-your-private-integration-token
GHL_LOCATION_ID=your-location-id
# Optional: your white label app domain, used for the contact link in Slack
GHL_APP_URL=https://app.gohighlevel.com

# Optional: Slack incoming webhook for lead alerts and error alerts. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
